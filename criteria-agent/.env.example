# Model APIs (required)
OPENAI_API_KEY=
TYPESAFE_API_KEY=
MISTRAL_API_KEY=

# Langfuse API keys (optional): leave unset and Docker Compose generates a pair on first start
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# On a server, also set these
# PUBLIC_URL=https://your-host
# LANGFUSE_USER_PASSWORD=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=   # 64 hex characters: openssl rand -hex 32
